# Vercel contact form: configure these in Vercel Project Settings → Environment Variables.
GMAIL_USER=your-inbox@example.com
GMAIL_APP_PASSWORD=replace-with-a-new-gmail-app-password
CONTACT_TO=your-inbox@example.com

# Supabase: create a project and use its project URL and publishable/anon key here.
# Never put the Supabase service_role key in a VITE_ variable or browser code.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
